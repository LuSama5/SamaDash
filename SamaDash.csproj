<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 = API WinRT per i controlli multimediali (Windows 10 2004+) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>SamaDash</AssemblyTitle>
    <Version>0.4.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms serve solo per l'icona nella tray: evita conflitti di nomi con WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SamaDash.Tests\**" />
    <None Remove="SamaDash.Tests\**" />
    <Page Remove="SamaDash.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
