<Window x:Class="SamaDash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SamaDash" WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        SizeToContent="Height" Width="1100" Background="Transparent" AllowDrop="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F2F2F4"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown"
        PreviewDragEnter="OnDragOver" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="6,14,0,6" />
        </Style>

        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D0D3D8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="#14FFFFFF" CornerRadius="12" Padding="12,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Riquadro con icona: suggeriti, recenti, shortcut -->
        <DataTemplate x:Key="Tile">
            <Button Style="{StaticResource Flat}" Width="92" Padding="4,10,4,8" Margin="0,0,4,4"
                    ToolTip="{Binding Path}" Click="OnTileClick" MouseRightButtonUp="OnTileRightClick">
                <StackPanel>
                    <Grid Width="32" Height="32">
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyphs}" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdd}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="0,6,0,0" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="#B0121216" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="18,12,18,14">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
        <StackPanel>
            <!-- Ricerca -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Glyphs}" FontSize="18"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,12,0" />
                <TextBox x:Name="Query" Grid.Column="1" FontSize="20" Height="42" Background="Transparent"
                         BorderThickness="0" Foreground="White" CaretBrush="White" SelectionBrush="{StaticResource Accent}"
                         VerticalContentAlignment="Center" TextChanged="OnQueryChanged" />
                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Cerca app, file e cartelle…" IsHitTestVisible="False"
                           FontSize="20" Foreground="#6B7076" VerticalAlignment="Center" Margin="3,0,0,0" />
                <!-- Schede -->
                <Border Grid.Column="2" Background="#0FFFFFFF" CornerRadius="9" Padding="3" Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="HomeTab" Style="{StaticResource Tab}" GroupName="Tabs" IsChecked="True"
                                     Checked="OnTabChanged">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Glyphs}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="Home" Margin="6,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="DisplaysTab" Style="{StaticResource Tab}" GroupName="Tabs" Checked="OnTabChanged"
                                     ToolTip="Luminosità, HDR, frequenza e modalità di proiezione">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Glyphs}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="Schermi" Margin="6,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Button x:Name="HotkeyButton" Grid.Column="3" Style="{StaticResource Flat}" Height="34" Padding="8,0"
                        Margin="0,0,4,0" Click="OnHotkeyClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource Glyphs}" FontSize="15"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="HotkeyText" FontSize="11.5" Foreground="{StaticResource Muted}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="Pin" Grid.Column="4" Width="34" Height="34" Cursor="Hand"
                              ToolTip="Tieni aperta (per trascinare file qui sopra)" FocusVisualStyle="{x:Null}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                                <TextBlock x:Name="Glyph" Text="&#xE718;" FontFamily="{StaticResource Glyphs}" FontSize="15"
                                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE841;" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
            <Border Height="1" Background="#1FFFFFFF" Margin="0,10,0,0" />

            <!-- Risultati -->
            <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="2,10,0,8">
                    <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Tag="" Content="Tutto" IsChecked="True" Checked="OnFilterChanged" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Tag="app" Content="App" Checked="OnFilterChanged" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Tag="doc:" Content="Documenti" Checked="OnFilterChanged" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Tag="pic:" Content="Immagini" Checked="OnFilterChanged" />
                    <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Tag="folder:" Content="Cartelle" Checked="OnFilterChanged" />
                </StackPanel>
                <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" Margin="8,6" Visibility="Collapsed" />
                <ListBox x:Name="Results" MaxHeight="470" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="OnResultClick" MouseRightButtonUp="OnResultRightClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#405B8CFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Left"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Glyphs}" FontSize="20"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#F2F2F4" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Invio apri · Ctrl+Invio apri cartella · tasto destro per altre opzioni" FontSize="11"
                           Foreground="#6B7076" Margin="8,8,0,0" />
            </StackPanel>

            <!-- Home -->
            <StackPanel x:Name="HomePanel">
                <!-- In riproduzione: compare solo quando un'app sta riproducendo -->
                <StackPanel x:Name="MusicPanel" Visibility="Collapsed">
                    <TextBlock Text="IN RIPRODUZIONE" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#478C4D99" Offset="0" />
                                <GradientStop Color="#0AFFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MusicCover" Width="60" Height="60" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F97359" Offset="0" />
                                        <GradientStop Color="#7340D9" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="MusicCoverGlyph" Text="&#xE8D6;" FontFamily="{StaticResource Glyphs}" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MusicTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MusicArtist" FontSize="12" Foreground="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Glyphs}" FontSize="11"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MusicApp" FontSize="11" Foreground="{StaticResource Muted}" Margin="5,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="MusicPrev" Style="{StaticResource Flat}" Width="34" Height="34" Click="OnMusicPrev"
                                            ToolTip="Precedente">
                                        <TextBlock Text="&#xE892;" FontFamily="{StaticResource Glyphs}" FontSize="14" />
                                    </Button>
                                    <Button Width="40" Height="40" Margin="12,0" Click="OnMusicPlayPause" Cursor="Hand"
                                            FocusVisualStyle="{x:Null}" ToolTip="Riproduci / pausa">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" Background="White" CornerRadius="20">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#DCE0E6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock x:Name="MusicPlayGlyph" Text="&#xE769;" FontFamily="{StaticResource Glyphs}"
                                                   FontSize="15" Foreground="#141418" />
                                    </Button>
                                    <Button x:Name="MusicNext" Style="{StaticResource Flat}" Width="34" Height="34" Click="OnMusicNext"
                                            ToolTip="Successivo">
                                        <TextBlock Text="&#xE893;" FontFamily="{StaticResource Glyphs}" FontSize="14" />
                                    </Button>
                                </StackPanel>
                                <Grid x:Name="MusicProgressRow" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MusicPosition" FontSize="11" Foreground="{StaticResource Muted}" />
                                    <Grid x:Name="MusicTrack" Grid.Column="1" Height="4" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="MusicDone" Width="0*" />
                                            <ColumnDefinition x:Name="MusicLeft" Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" Background="#24FFFFFF" CornerRadius="2" />
                                        <Border Background="#D9FFFFFF" CornerRadius="2" />
                                    </Grid>
                                    <TextBlock x:Name="MusicDuration" Grid.Column="2" FontSize="11" Foreground="{StaticResource Muted}"
                                               TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                            <Button x:Name="MusicSourceButton" Grid.Column="3" Style="{StaticResource Flat}" Padding="10,6"
                                    Background="#0FFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="OnMusicSource" ToolTip="Scegli quale app controllare">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="MusicSourceText" FontSize="12" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Glyphs}" FontSize="9"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Text="SUGGERITI" Style="{StaticResource SectionTitle}" />
                <WrapPanel>
                    <ItemsControl x:Name="SuggestedApps" ItemTemplate="{StaticResource Tile}" ItemsPanel="{StaticResource Wrap}" />
                    <Border x:Name="SuggestSeparator" Width="1" Height="56" Background="#1FFFFFFF" Margin="8,0,12,4" />
                    <ItemsControl x:Name="RecentFiles" ItemTemplate="{StaticResource Tile}" ItemsPanel="{StaticResource Wrap}" />
                </WrapPanel>
                <TextBlock x:Name="SuggestHint" Text="Sto imparando le tue abitudini: le app suggerite compariranno dopo un po' di utilizzo."
                           FontSize="11.5" Foreground="#6B7076" Margin="6,0,0,4" Visibility="Collapsed" />

                <!-- Salute PC | Controlli -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="SALUTE PC" Style="{StaticResource SectionTitle}" />
                        <StackPanel x:Name="HealthBars" Margin="6,0,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="CleanupButton" Style="{StaticResource Flat}" Padding="10,6" Click="OnCleanupToggle">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Glyphs}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="Libera spazio" FontSize="12" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Flat}" Padding="10,6" Click="OnAdvancedCleanup"
                                    ToolTip="Pulizia disco di Windows (file di sistema, aggiornamenti)">
                                <TextBlock Text="Pulizia avanzata Windows" FontSize="12" Foreground="{StaticResource Muted}" />
                            </Button>
                        </StackPanel>
                        <Border x:Name="CleanupPanel" Visibility="Collapsed" Background="#0FFFFFFF" CornerRadius="8"
                                Padding="10,8" Margin="0,4,0,0">
                            <StackPanel>
                                <StackPanel x:Name="CleanupItems" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="CleanButton" Style="{StaticResource Flat}" Padding="12,5" Click="OnClean"
                                            Background="#335B8CFF">
                                        <TextBlock x:Name="CleanButtonText" Text="Pulisci selezionati" FontSize="12" />
                                    </Button>
                                    <TextBlock x:Name="CleanupStatus" FontSize="11.5" Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CONTROLLI" Style="{StaticResource SectionTitle}" />
                        <!-- Uscita audio -->
                        <Button x:Name="OutputButton" Style="{StaticResource Flat}" Padding="8,6" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Click="OnOutputClick" ToolTip="Cambia uscita audio">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource Glyphs}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="OutputName" Grid.Column="1" FontSize="12.5" Margin="10,0" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource Glyphs}" FontSize="10"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <!-- Volume -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MuteButton" Style="{StaticResource Flat}" Width="32" Height="30" Click="OnMuteClick" ToolTip="Muto">
                                <TextBlock x:Name="MuteGlyph" Text="&#xE767;" FontFamily="{StaticResource Glyphs}" FontSize="14" />
                            </Button>
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                    Margin="6,0" IsMoveToPointEnabled="True" ValueChanged="OnVolumeChanged" />
                            <TextBlock x:Name="VolumeText" Grid.Column="2" FontSize="12" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                        <!-- Tema e Non disturbare -->
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="ThemeButton" Style="{StaticResource Flat}" Padding="10,6" Margin="0,0,6,0" Click="OnThemeClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE706;" FontFamily="{StaticResource Glyphs}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ThemeText" FontSize="12" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DndButton" Style="{StaticResource Flat}" Padding="10,6" Click="OnDndClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7ED;" FontFamily="{StaticResource Glyphs}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="Non disturbare" FontSize="12" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="SHORTCUT  ·  trascina qui file, cartelle o link" Style="{StaticResource SectionTitle}" />
                <ItemsControl x:Name="ShortcutList" ItemTemplate="{StaticResource Tile}" ItemsPanel="{StaticResource Wrap}" />

                <TextBlock Text="SISTEMA" Style="{StaticResource SectionTitle}" />
                <WrapPanel x:Name="SystemBar" />
            </StackPanel>

            <!-- Schermi: le schede vengono create dal codice in base ai monitor collegati -->
            <StackPanel x:Name="DisplaysPanel" Visibility="Collapsed">
                <TextBlock Text="SCHERMI RILEVATI" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="DisplaysStatus" Text="Lettura degli schermi…" FontSize="12" Foreground="{StaticResource Muted}"
                           Margin="6,0,0,6" />
                <UniformGrid x:Name="DisplayCards" Rows="1" Margin="-6,0" />

                <TextBlock Text="TUTTI GLI SCHERMI" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ProjectionPanel" VerticalAlignment="Center">
                            <TextBlock Text="Modalità proiezione" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                            <WrapPanel x:Name="ProjectionChoices" Margin="0,0,0,-6" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Flat}" Background="#0FFFFFFF" Padding="14,9" Margin="12,0,0,0"
                                VerticalAlignment="Center" Click="OnNightLight">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE708;" FontFamily="{StaticResource Glyphs}" FontSize="15" VerticalAlignment="Center" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Luce notturna" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Apre le impostazioni" FontSize="11" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource Flat}" Background="#0FFFFFFF" Padding="14,9" Margin="8,0,0,0"
                                VerticalAlignment="Center" Click="OnDisplaySettings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource Glyphs}" FontSize="15" VerticalAlignment="Center" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Impostazioni schermo" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Risoluzione, scala, disposizione" FontSize="11" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
